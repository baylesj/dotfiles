   "notepad_default": {
      "message": "\uFEFF\u0627\u0643\u062A\u0628 \u0623\u064A \u0634\u064A\u0621 \u0647\u0646\u0627. \u0633\u064A\u062A\u0645 \u062D\u0641\u0638 \u0643\u0644 \u0645\u0627 \u062A\u0643\u062A\u0628\u0647 \u0639\u0644\u0649 \u0643\u0644 \u0636\u063A\u0637\u0647 \u0645\u0641\u062A\u0627\u062D.\n\n\u0643\u0646 \u062D\u0630\u0631\u0627\u064B \u0631\u063A\u0645 \u0630\u0644\u0643\u061B \u0644\u0627 \u064A\u0648\u062C\u062F \u0646\u0633\u062E\u0629 \u0627\u062D\u062A\u064A\u0627\u0637\u064A\u0629\u060C \u0648\u0627\u0644\u0632\u0631 \u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646 * \u064A\u0639\u0645\u0644 * \u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646 \u0647\u0630\u0647 \u0627\u0644\u0642\u0637\u0639\u0629"
   },
