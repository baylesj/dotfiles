   "rctm_clear_all_confirm": {
      "message": "\u039A\u03B1\u03B8\u03B1\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03C2 \u03C4\u03BF \u03BC\u03B5\u03BD\u03BF\u03CD \"\u03C0\u03C1\u03CC\u03C3\u03C6\u03B1\u03C4\u03B1 \u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03AC \u03BA\u03B1\u03C1\u03C4\u03AD\u03BB\u03B5\u03C2\" \u03B4\u03B5\u03BD \u03BA\u03B1\u03B8\u03B1\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03B5\u03C1\u03B9\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5 Chrome. \u0391\u03C5\u03C4\u03AE \u03B7 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B1\u03C0\u03B1\u03BB\u03B5\u03AF\u03C6\u03B5\u03B9 \u03BC\u03CC\u03BD\u03BF \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1."
