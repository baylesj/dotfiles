#
# Openbox shutdown dialog
#

[general]
version =        0.1-rc1
verbose =        false
default_action = shutdown
composite =      true
theme =          foom-tiny
buttons =        cancel logout lock shutdown restart suspend #hibernate

[actions]
#logout =         echo 'awesome.restart()' | awesome-client
shutdown =       sudo systemctl poweroff
restart =        sudo systemctl reboot
lock =           slimlock
#hibernate =      sudo systemctl hibernate
suspend =        sudo systemctl suspend

[shortcuts]
#logout =         x
shutdown =       s
restart =        r
lock =           l
suspend =        u
#hibernate =      h

[labels]
cancel =         CANCEL
logout =         LOGOUT
restart =        RESTART
shutdown =       SHUTDOWN
lock =           LOCK
suspend =        SUSPEND
#hibernate =      HIBERNATE
