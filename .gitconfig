# User Information
[user]
	name = Jordan Bayles
	email = jophba@chromium.org

# Core Settings
[core]
	editor = vim
	whitespace = fix, -indent-with-non-tab, trailing-space, cr-at-eol
	excludesfile = ~/.gitignore
	pager = cat
	precomposeUnicode = true
	trustctime = false
	packedGitLimit = 512m
	packedGitWindowSize = 512m

# Default Branches
[init]
	defaultBranch = main

# Color Settings
[color]
	ui = auto

# HTTP Settings
[http]
	# Gitconfig doesn't support conditionals or environment vars,
	# so need a crossplatform cookiefile location. Make sure to move
	# the cookie file from its default location
	#cookiefile = /Users/jophba/.gitcookies
	cookiefile = /usr/local/google/home/jophba/.gitcookies
	sslVerify = false

# Pager Settings
[pager]
	branch = false

# Merge Settings
[merge]
	tool = vscode

[mergetool "vscode"]
	cmd = code --wait $MERGED

# Diff Settings
[diff]
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

# Push Settings
[push]
	default = current
	followTags = true
	autoSetupRemote = true

# Pull Settings
[pull]
	rebase = false

# Fetch Settings
[fetch]
	prune = true

# Git LFS
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Depot Tools
[depot-tools]
	useNewAuthStack = 1

# Pack Settings
[pack]
	window = 1
	deltaCacheSize = 2047m
	packSizeLimit = 2047m
	windowMemory = 2047m

# Protocol Settings
[protocol "sso"]
	allow = always

# Google/Chromium URL Rewrites
[url "persistent-https://chrome-internal.git.corp.google.com/"]
	insteadOf = https://chrome-internal.googlesource.com/

[url "sso://chromium/"]
	insteadOf = https://chromium.googlesource.com/

[url "sso://chromium"]
	insteadOf = https://chromium.googlesource.com
	insteadOf = https://chromium-review.googlesource.com

[url "sso://chrome-internal/"]
	insteadOf = https://chrome-internal.googlesource.com/

[url "sso://chrome-internal"]
	insteadOf = https://chrome-internal.googlesource.com
	insteadOf = https://chrome-internal-review.googlesource.com

# Aliases
[alias]
	# Gerrit/Code Review Workflow
	up = cl upload
	poh = push origin HEAD:refs/for/main
	can = commit --amend --no-edit
	bsu = branch --set-upstream-to=origin/main

	# Add
	a = add --all
	ai = add -i

	# Apply
	ap = apply
	as = apply --stat
	ac = apply --check

	# AM (Apply Mailbox)
	ama = am --abort
	amr = am --resolved
	ams = am --skip

	# Branch
	br = branch
	bra = branch -a
	brd = branch -d
	brr = branch -r

	# Checkout
	co = checkout
	cob = checkout -b

	# Commit
	c = commit
	ca = commit -a
	cm = commit -m
	cam = commit -am
	cd = commit --amend
	cad = commit -a --amend
	cem = commit --allow-empty -m
	ced = commit --allow-empty --amend

	# Cherry-pick
	cp = cherry-pick
	cpc = cherry-pick --continue

	# Diff
	d = diff
	dc = diff --cached
	dk = diff --check
	dp = diff --patience
	dck = diff --cached --check
	dl = difftool
	dlc = difftool --cached
	last = diff HEAD^..HEAD --name-only

	# Fetch
	f = fetch
	fo = fetch origin
	fu = fetch upstream

	# Format-patch
	fp = format-patch

	# Fsck
	fk = fsck

	# Grep
	g = grep -p

	# Log
	l = log --oneline
	lg = log --oneline --graph --decorate
	lgm = log --oneline --merges

	# List Files
	ls = ls-files
	lsf = "!git ls-files | grep -i"

	# Merge
	m = merge
	ma = merge --abort
	mc = merge --continue
	ms = merge --skip

	# Prune
	pr = prune -v

	# Pull
	pl = pull
	plu = pull -u
	plo = pull origin
	pb = pull --rebase
	pbo = pull --rebase origin

	# Push
	ps = push
	psf = push -f
	psu = push -u
	pso = push origin
	psuo = push -u origin
	psom = push origin master
	psuom = push -u origin master

	# Rebase
	rb = rebase
	rba = rebase --abort
	rbc = rebase --continue
	rbi = rebase --interactive
	rbs = rebase --skip

	# Remote
	r = remote
	ra = remote add
	rr = remote rm
	rv = remote -v
	rm = remote rename
	rp = remote prune
	rs = remote show
	rao = remote add origin
	rau = remote add upstream
	rso = remote show origin
	rsu = remote show upstream
	rpo = remote prune origin
	rpu = remote prune upstream

	# Reset
	re = reset
	rh = reset HEAD
	reh = reset --hard
	rem = reset --mixed
	res = reset --soft
	rehh = reset --hard HEAD
	remh = reset --mixed HEAD
	resh = reset --soft HEAD

	# Show
	w = show
	wp = show -p
	wr = show -p --no-color

	# Stash
	sa = stash apply
	sc = stash clear
	sd = stash drop
	sl = stash list
	sp = stash pop
	ss = stash save
	sw = stash show

	# Status
	st = status
	stb = status -s -b

	# Assume Unchanged
	assume = update-index --assume-unchanged
	unassume = update-index --no-assume-unchanged
	assumed = "!git ls-files -v | grep ^h | cut -c 3-"
	unassumeall = !git assumed | xargs git update-index --no-assume-unchanged
	assumeall = "!git st -s | awk {'print $2'} | xargs git assume"

	# Conflict Resolution
	ours = "!f() { git checkout --ours $@ && git add $@; }; f"
	theirs = "!f() { git checkout --theirs $@ && git add $@; }; f"

	# Utilities
	whois = "!sh -c 'git log -i -1 --pretty=\"format:%an <%ae>\n\" --author=\"$1\"' -"
	whatis = show -s --pretty='tformat:%h (%s, %ad)' --date=short
	barebranch = !sh -c 'git symbolic-ref HEAD refs/heads/$1 && git rm --cached -r . && git clean -xfd' -
	flat = clone --depth 1
	subpull = !git submodule foreach git pull --tags origin master
	subrepo = !sh -c 'filter-branch --prune-empty --subdirectory-filter $1 master' -
	human = name-rev --name-only --refs=refs/heads/*
	serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git
	snapshot = !git stash save "snapshot: $(date)" && git stash apply "stash@{0}"
