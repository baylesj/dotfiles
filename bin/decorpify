#!/usr/bin/env python3

import sys
import re
import fileinput

def decorpify(text):
    # Gerrit Review
    def clean_gerrit_url(match):
        domain_prefix = match.group(1)
        path = match.group(2)
        # Remove usp=... query param
        path = re.sub(r'[?&]usp=[a-zA-Z0-9_-]+', '', path)
        # Clean up any dangling ? if it was the only query param
        path = re.sub(r'\?(?:$|#)', '', path)
        return f'https://{domain_prefix}-review.googlesource.com{path}'

    text = re.sub(
        r'https?://([a-zA-Z0-9-]+)-review(?:\.git)?\.corp\.google\.com([^\s\'"<>]*)',
        clean_gerrit_url,
        text
    )
    
    # Code Search / Chromium Source
    text = re.sub(
        r'https?://source\.corp\.google\.com',
        r'https://source.chromium.org',
        text
    )
    text = re.sub(
        r'https?://cs\.corp\.google\.com',
        r'https://source.chromium.org',
        text
    )

    # Issue Tracker / Buganizer
    text = re.sub(
        r'https?://(?:b|buganizer|issuetracker)\.corp\.google\.com/(?:issues?/)?(\d+)',
        r'https://crbug.com/\1',
        text
    )
    text = re.sub(
        r'https?://b/(\d+)',
        r'https://crbug.com/\1',
        text
    )

    return text

def main():
    # fileinput.input() reads from files passed as arguments or stdin if none are provided
    for line in fileinput.input():
        sys.stdout.write(decorpify(line))

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
