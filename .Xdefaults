
!!!!!!!!!!!
! General !
!!!!!!!!!!!

! Fonts
! *.dpi: 192 ! Disabled, respecting Xserver dpi config

! Cursor
Xcursor.theme: Adwaita
Xcursor.size: 28

!!!!!!!!!
! XTerm !
!!!!!!!!!

xterm*faceName: Droid Sans Mono Slashed
xterm*faceSize: 12

!!!!!!!!!
! URxvt !
!!!!!!!!!

! Fonts
URxvt.font: xft:Droid Sans Mono Slashed:size=10,style=medium
URxvt.boldFont: xft:Droid Sans Mono Slashed:size=10,style=bold
URxvt.italicFont: xft:Droid Sans Mono Slashed:size=10,style=bold
URxvt.boldItalicFont: xft:Droid Sans Mono Slashed:size=10,style=bold
URxvt.letterSpace: -1


URxvt.depth: 32
URxvt.foreground: #d0d0d0
URxvt.background: rgba:0000/0000/0200/0900

! OS Integration
URxvt.iconFile:        /usr/share/icons/Tango/scalable/apps/terminal.svg
URxvt.perl-ext-common: default, matcher, tabbed
URxvt.urlLauncher:     /usr/bin/google-chrome
URxvt.matcher.button:  1
URxvt.keysym.F11:      perl:fullscreen:switch

! UI
URxvt*borderless: true
URxvt.internalBorder: 10
URxvt*scrollBar: false
URxvt*saveLines: 20000
URxvt*dynamicColors: true
URxvt*termName: rxvt-unicode
URxvt*fading: 10

! Colors
URxvt.depth: 32
URxvt.intensityStyles: false
!black.normal     : xoria256.LineNr.guibg
!black.bright     : black.normal.rgb - 8
URxvt.color0      : #121212
URxvt.color8      : #0a0a0a

!red.normal       : red.bright.r - 8
!red.bright       : xoria256.Special.guifg
URxvt.color1      : #d78787
URxvt.color9      : #df8787

!green.normal     : green.bright.g - 8
!green.bright     : xoria256.PreProc.guifg
URxvt.color2      : #afd787
URxvt.color10     : #afdf87

!yellow.normal    : yellow.bright.rg - 8
!yellow.bright    : xoria256.Special.guifg
URxvt.color3      : #f7f7af
URxvt.color11     : #ffffaf

!blue.normal      : blue.bright.b - 8
!blue.bright      : xoria256.Statement.guifg
URxvt.color4      : #87afd7
URxvt.color12     : #87afdf

!magenta.normal   : magenta.bright.rb - 8
!magenta.bright   : xoria256.Identifier.guifg
URxvt.color5      : #d7afd7
URxvt.color13     : #dfafdf

!cyan.normal      : cyan.bright.gb - 8
!cyan.bright      : green.bright + blue.bright
URxvt.color6      : #afd7d7
URxvt.color14     : #afdfdf

!white.normal     : white.bright.rgb - 8
!white.bright     : xoria256.Folded.guifg
URxvt.color7      : #e6e6e6
URxvt.color15     : #eeeeee

!foreground       : xoria256.Normal.guifg
!background       : xoria256.Normal.guibg
!cursor           : xoria256.
!URxvt.foreground  : #d0d0d0
!URxvt.background  : #1c1c1c
URxvt.cursorColor : #eeeeee

!bold             : xoria256.Type.guifg
!underline        : xoria256.htmlValue.guifg
URxvt.colorBD     : #afafdf
URxvt.colorUL     : #dfdfaf

! Extensions
URxvt.perl-ext: default,url-select,clipboard
URxvt.perl-ext-common: default,matcher

URxvt.keysym.Control-Alt-C: perl:clipboard:copy
URxvt.keysym.Control-Alt-V: perl:clipboard:paste

URxvt.url-launcher: /usr/bin/google-chrome
URxvt.matcher.button: 1

!!!!!!!!
! Rofi !
!!!!!!!!

rofi.font: Droid Sans Mono Slashed Medium 12
rofi.lines: 3
rofi.separator-style: none
rofi.hide-scrollbar: true
rofi.opacity: 96
rofi.bw: 6
rofi.padding: 10

rofi.fuzzy: true
rofi.sidebar-mode: false
