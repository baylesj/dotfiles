# Follows macOS appearance (System Settings → Appearance → Auto for sunrise/sunset)
theme = light:Noctis Lux,dark:TokyoNight

font-size = 15

# On ssh, install Ghostty's terminfo on the remote host, falling back to
# TERM=xterm-256color (plus COLORTERM) if that fails.
shell-integration-features = ssh-env,ssh-terminfo

# Uncomment to try a font from FONTS.md. Ghostty ships Nerd Font symbols
# itself, so plain (unpatched) fonts work with the p10k prompt.
# font-family = JetBrains Mono
# font-family = Atkinson Hyperlegible Mono
